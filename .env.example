TITAN_ENV=development
TITAN_LOG_LEVEL=INFO
TITAN_DATABASE_URL=postgresql+asyncpg://titan:titan@localhost:5432/titan
TITAN_TEMPORAL_TARGET=localhost:7233
TITAN_TEMPORAL_NAMESPACE=default
TITAN_TEMPORAL_TASK_QUEUE=titan-core
TITAN_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
TITAN_OBJECT_STORAGE_BUCKET=titan
TITAN_OTEL_ENDPOINT=http://localhost:4317
TITAN_ORCHESTRATION_MAX_COST=0
TITAN_RECOVERY_AUTO_ENABLED=false
TITAN_RECOVERY_MAX_ATTEMPTS=2
TITAN_RECOVERY_MIN_AUTONOMY_LEVEL=3
TITAN_RECOVERY_MAX_AUTO_RISK_LEVEL=R1
TITAN_OPERATOR_AUTH_REQUIRED=false
TITAN_OPERATOR_API_TOKEN=
TITAN_OPERATOR_SUBJECT=local-development-operator
TITAN_OPERATOR_ROLE=operator
TITAN_HUMAN_APPROVAL_TIMEOUT_SECONDS=86400
