TITAN_ENV=development
TITAN_LOG_LEVEL=INFO
TITAN_DATABASE_URL=postgresql+asyncpg://titan:titan@localhost:5432/titan
TITAN_TEMPORAL_TARGET=localhost:7233
TITAN_TEMPORAL_NAMESPACE=default
TITAN_TEMPORAL_TASK_QUEUE=titan-core
TITAN_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
TITAN_OBJECT_STORAGE_BUCKET=titan
TITAN_OTEL_ENDPOINT=http://localhost:4317
TITAN_ORCHESTRATION_MAX_COST=0
TITAN_RECOVERY_AUTO_ENABLED=false
TITAN_RECOVERY_MAX_ATTEMPTS=2
TITAN_RECOVERY_MIN_AUTONOMY_LEVEL=3
TITAN_RECOVERY_MAX_AUTO_RISK_LEVEL=R1
TITAN_OPERATOR_AUTH_REQUIRED=false
TITAN_OPERATOR_AUTH_MODE=oidc
TITAN_OPERATOR_API_TOKEN=
TITAN_OPERATOR_SUBJECT=local-development-operator
TITAN_OPERATOR_ROLE=operator
TITAN_OIDC_ISSUER_URL=
TITAN_OIDC_AUDIENCE=
TITAN_OIDC_JWKS_URL=
TITAN_OIDC_CLIENT_ID=
TITAN_OIDC_CLIENT_SECRET=
TITAN_OIDC_AUTHORIZATION_ENDPOINT=
TITAN_OIDC_TOKEN_ENDPOINT=
TITAN_OIDC_USERINFO_ENDPOINT=
TITAN_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
TITAN_OIDC_SCOPES=openid profile email
TITAN_OIDC_ROLES_CLAIM=roles
TITAN_OIDC_ADMIN_ROLES=admin,titan-admin
TITAN_OIDC_OPERATOR_ROLES=operator,titan-operator
TITAN_OIDC_VIEWER_ROLES=viewer,titan-viewer
TITAN_OIDC_REQUIRED_SCOPE=
TITAN_OIDC_CLOCK_SKEW_SECONDS=30
TITAN_OIDC_JWKS_CACHE_SECONDS=300
TITAN_OIDC_REQUEST_TIMEOUT_SECONDS=5
TITAN_OIDC_REQUIRE_HTTPS=true
TITAN_OPERATOR_SESSION_COOKIE_NAME=titan_session
TITAN_OPERATOR_SESSION_TTL_SECONDS=28800
TITAN_OPERATOR_SESSION_ROTATION_SECONDS=3600
TITAN_OPERATOR_SESSION_COOKIE_SECURE=false
TITAN_OPERATOR_SESSION_COOKIE_SAMESITE=lax
TITAN_OIDC_AUTH_STATE_TTL_SECONDS=600
TITAN_HUMAN_APPROVAL_TIMEOUT_SECONDS=86400
